{
  "name": "automated-documentation-sync",
  "version": "0.1.0",
  "description": "Agentic SDLC capstone: automated documentation synchronization CLI with Copilot agent workflow",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "cli": "tsx --env-file-if-exists=.env src/cli.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.1.2"
  }
}
