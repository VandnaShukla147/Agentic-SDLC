# Copy to .env and fill in values. Never commit .env or real credentials.
# Put real values ONLY in .env (git-ignored), never in this file.
# Demo mode (default) needs none of the optional variables below.

# Application
APP_ENV=development
STORY_SOURCE=demo

# GitHub - optional (not used by the current code)
GITHUB_TOKEN=YOUR_GITHUB_TOKEN_HERE
GITHUB_REPOSITORY_URL=YOUR_REPOSITORY_URL_HERE

# Jira - optional (required only when STORY_SOURCE=jira)
JIRA_BASE_URL=YOUR_JIRA_BASE_URL_HERE
JIRA_PROJECT_KEY=YOUR_JIRA_PROJECT_KEY_HERE
JIRA_EMAIL=YOUR_JIRA_EMAIL_HERE
JIRA_API_TOKEN=YOUR_JIRA_API_TOKEN_HERE
# Optional custom field id holding acceptance criteria (e.g. customfield_10000)
JIRA_ACCEPTANCE_CRITERIA_FIELD=

# Confluence - optional (not used by the current code)
CONFLUENCE_BASE_URL=YOUR_CONFLUENCE_BASE_URL_HERE
CONFLUENCE_EMAIL=YOUR_CONFLUENCE_EMAIL_HERE
CONFLUENCE_API_TOKEN=YOUR_CONFLUENCE_API_TOKEN_HERE
CONFLUENCE_SPACE_KEY=YOUR_CONFLUENCE_SPACE_KEY_HERE
